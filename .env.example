# Copy this file to .env and fill in the values.

# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/thyrocare_up166?retryWrites=true&w=majority
# Optional: database name (otherwise the one in the URI, or "thyrocare_up166")
DB_NAME=

# Long random text used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First admin login (only used when the database is empty).
# If ADMIN_PASSWORD is empty, the default is admin / Thyrocare@166 and it must be changed on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

PORT=3000

# Public address of the website (used for Google: canonical links, sitemap, share previews)
SITE_URL=https://thyrocarelucknow.com
# Optional: Google Search Console / Bing "HTML tag" verification codes (only the content="…" value)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NODE_ENV=production
